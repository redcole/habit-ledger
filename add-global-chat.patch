+  color: var(--muted);
+  cursor: pointer;
+  font-size: 14px;
+  padding: 4px;
+}
+
+.chat-close:hover {
+  color: var(--rust);
+}
+
+.chat-messages {
+  flex: 1;
+  overflow-y: auto;
+  padding: 12px 14px;
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+}
+
+.chat-empty {
+  color: var(--muted);
+  font-size: 12px;
+  text-align: center;
+  margin: auto 0;
+}
+
+.chat-message-meta {
+  display: flex;
+  align-items: baseline;
+  gap: 8px;
+  margin-bottom: 2px;
+}
+
+.chat-author {
+  font-family: var(--display);
+  font-weight: 600;
+  font-size: 12px;
+  color: var(--sage);
+}
+
+.chat-time {
+  font-size: 10px;
+  color: var(--muted);
+}
+
+.chat-content {
+  margin: 0;
+  font-size: 13px;
+  color: var(--ink);
+  line-height: 1.4;
+  word-break: break-word;
+  white-space: pre-wrap;
