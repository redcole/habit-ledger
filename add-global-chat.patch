+  border-radius: 8px;
+  box-shadow: 0 8px 30px rgba(35, 43, 37, 0.2);
+  display: flex;
+  flex-direction: column;
+  overflow: hidden;
+}
+
+.chat-panel-header {
+  display: flex;
+  align-items: center;
