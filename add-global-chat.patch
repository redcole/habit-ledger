+
+.chat-input-row {
+  display: flex;
+  gap: 8px;
+  padding: 10px;
+  border-top: 1px solid var(--border);
+  flex-shrink: 0;
+}
+
+.chat-input-row input {
+  flex: 1;
+  background: var(--panel-raised);
+  border: 1px solid var(--border);
+  color: var(--ink);
+  font-family: var(--body);
+  font-size: 13px;
+  padding: 8px 10px;
+  border-radius: 3px;
+  outline: none;
+}
+
+.chat-input-row input:focus {
+  border-color: var(--amber);
+}
+
+.chat-input-row button {
+  background: var(--amber);
+  color: var(--on-accent);
+  border: 1px solid var(--amber);
+  font-weight: 600;
+  font-size: 12px;
+  padding: 0 14px;
+  border-radius: 3px;
+  cursor: pointer;
+}
+
+.chat-input-row button:disabled {
+  opacity: 0.5;
+  cursor: not-allowed;
+}
+
+.chat-signed-out {
+  padding: 10px 14px;
+  margin: 0;
+  font-size: 12px;
+  color: var(--muted);
+  border-top: 1px solid var(--border);
+  flex-shrink: 0;
+}
+
+.chat-error {
+  margin: 0;
+  padding: 6px 14px 0;
+  font-size: 11px;
+  color: var(--rust);
+  flex-shrink: 0;
+}
+
+.chat-disclaimer {
+  margin: 0;
+  padding: 6px 14px 10px;
+  font-size: 10px;
+  color: var(--muted);
+  text-align: center;
+  flex-shrink: 0;
+}
+
+@media (max-width: 480px) {
+  .chat-widget {
+    bottom: 16px;
+    right: 16px;
+  }
+  .chat-panel {
+    width: calc(100vw - 32px);
+  }
+}
